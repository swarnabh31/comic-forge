# Copy to .env and edit. Every setting is optional; the defaults are what the app was tested with.

# ---- Language model (script writing + chat assistant)
LLM_PROVIDER=ollama               # ollama | hf
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384              # context window requested from Ollama (its default is too small and silently truncates prompts)
LLM_KEEP_ALIVE=5m
UNLOAD_LLM_BEFORE_DRAWING=1       # free the LLM's VRAM before the image model starts (recommended on one GPU)
# HF_TOKEN=
# HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- Comics craft knowledge (backend/knowledge/comics_expert.md)
COMICS_EXPERT=condensed           # condensed (default, ~900 tokens) | full (whole guide, ~6.5k tokens, needs OLLAMA_NUM_CTX>=16384) | off

# ---- Image generation
IMAGE_PROVIDER=qwen               # qwen | local | hf_inference
QWEN_STEPS=20
QWEN_PANEL_SIZE=1024              # 768 on <24 GB VRAM
PRELOAD_IMAGE_MODEL=1             # load the image model while the LLM writes the script
PORTRAIT_SIZE_SCALE=0.75          # character portraits are only conditioning images; smaller = faster
REF_MAX_SIDE=768                  # uploaded reference photos are shrunk to this
STYLE_NORMALIZE_REFS=1            # redraw uploaded characters once in the chosen art style so every panel matches
# PANEL_SIZE=768                  # SDXL path
# IMAGE_STEPS=40                  # SDXL path

# ---- Defaults shown in the UI
DEFAULT_TEXT_SIZE=medium          # small | medium | large
DEFAULT_QUALITY=standard          # draft | standard | high

# ---- Limits
MAX_PANELS=8
MAX_CHARACTERS=6
MAX_UPLOAD_MB=15
